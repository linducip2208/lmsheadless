{
  "name": "lms-headless",
  "version": "1.14.0",
  "private": true,
  "description": "Production-ready headless LMS (Cloudflare-native: Workers + D1 + R2 + KV)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --workspace apps/api run dev",
    "dev:admin": "npm --workspace apps/admin run dev",
    "dev:teacher": "npm --workspace apps/teacher run dev",
    "dev:student": "npm --workspace apps/student run dev",
    "dev:parent": "npm --workspace apps/parent run dev",
    "dev:web": "npm --workspace apps/web run dev",
    "build": "npm run build --workspaces --if-present",
    "test": "npm --workspace apps/api run test",
    "test:e2e": "npm --workspace apps/web run test:e2e",
    "test:coverage": "npm --workspace apps/api run test:coverage",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:migrate": "npm --workspace apps/api run db:migrate",
    "db:seed": "npm --workspace apps/api run db:seed",
    "audit": "npm --workspace apps/api run audit",
    "contract": "tsx scripts/check-contract.mts",
    "static-audit": "node scripts/static-audit.mjs",
    "bench": "node scripts/bench.mjs",
    "scale": "tsx scripts/scale-check.mts",
    "drill": "node scripts/r2-restore-drill.mjs",
    "contract:breaking": "node scripts/check-breaking.mjs",
    "contract:gaps": "node scripts/check-coverage-gaps.mjs",
    "gen:error-catalog": "node scripts/gen-error-catalog.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "eslint": "^9.12.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.1",
    "vite-plugin-purgecss": "^0.2.13"
  }
}
